# Copy to .env.local for local development. Never commit real values.
# In production, set these in the Vercel project's Environment Variables (server-side only).
# None of them may be prefixed NEXT_PUBLIC_: they must never reach the browser.

# Resend (https://resend.com) API key used by /api/post.
RESEND_API_KEY=

# Where letters from the Post page are delivered.
POST_TO_EMAIL=

# The sender address; must be on a domain verified in Resend, e.g. "Post <post@example.com>".
POST_FROM_EMAIL=

# Optional. Set to 1 only for a local production build that should include drafts.
# The build fails if this is set on a Vercel production deployment.
# INCLUDE_DRAFTS=

# ---- SEO / AEO (see docs/SEO_ENVIRONMENT_VARIABLES.md) ----
# Production origin used for canonical URLs, the sitemap, robots.txt and JSON-LD. Set it on Vercel
# for Production; previews then still point canonicals at production, never at *.vercel.app previews.
NEXT_PUBLIC_SITE_URL=https://satnamportfolio.vercel.app

# IndexNow key (8-128 hex characters). Served at /indexnow-key.txt for verification.
INDEXNOW_KEY=

# Bearer token for the private POST /api/seo/indexnow endpoint and the agent scripts. Long and random.
SEO_ADMIN_TOKEN=

# Local agent only (scripts/seo, never needed on Vercel):
# Google Search Console via a service account added as a user on the property.
GSC_SERVICE_ACCOUNT_EMAIL=
GSC_PRIVATE_KEY=
GSC_PROPERTY=
# Bing Webmaster Tools API key.
BING_WEBMASTER_API_KEY=
