# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Private, local-only writing: never committed, never deployed.
content/private/*
!content/private/README.md

# SEO agent history, reports and private dashboard (local only)
.seo/

# Raw source media: kept on this machine only. The site uses optimised copies in public/
# (public/traces/photos, public/traces/video, public/post, app/opengraph-image.jpg).
/Photography-*/
/Photography-*.zip
*.zip
/traces/
/elon-musk-marijuana.gif
/banner.png
/Firefly*.png
/sources/

# Editor and OS clutter
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
